{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Scenic: configure",
            "type": "process",
            "command": "cmake",
            "args": ["-S", ".", "-B", "build/editor-debug", "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Debug", "-DBUILD_EDITOR=ON"],
            "osx": {
                "args": ["--preset", "macos-editor"]
            },
            "windows": {
                "args": ["--preset", "windows-editor"]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Scenic: build",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "build/editor-debug", "--target", "Scenic"],
            "osx": {
                "args": ["--build", "--preset", "build-macos-editor", "--target", "Scenic"]
            },
            "windows": {
                "args": ["--build", "--preset", "build-windows-editor", "--target", "Scenic"]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Scenic: configure",
            "problemMatcher": ["$gcc"]
        }
    ]
}
