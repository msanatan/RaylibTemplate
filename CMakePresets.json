{
    "version": 5,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20
    },
    "configurePresets": [
        {
            "name": "macos-debug",
            "generator": "Ninja",
            "binaryDir": "build/macos-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_EDITOR": "OFF"
            }
        },
        {
            "name": "macos-release",
            "generator": "Ninja",
            "binaryDir": "build/macos-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_EDITOR": "OFF"
            }
        },
        {
            "name": "windows-debug",
            "generator": "Ninja",
            "binaryDir": "build/windows-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_EDITOR": "OFF"
            }
        },
        {
            "name": "windows-release",
            "generator": "Ninja",
            "binaryDir": "build/windows-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_EDITOR": "OFF"
            }
        },
        {
            "name": "web-debug",
            "generator": "Ninja",
            "binaryDir": "build/web-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_EDITOR": "OFF"
            }
        },
        {
            "name": "web-release",
            "generator": "Ninja",
            "binaryDir": "build/web-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_EDITOR": "OFF"
            }
        },
        {
            "name": "macos-editor",
            "inherits": "macos-debug",
            "binaryDir": "build/macos-editor",
            "cacheVariables": {
                "BUILD_EDITOR": "ON"
            }
        },
        {
            "name": "windows-editor",
            "inherits": "windows-debug",
            "binaryDir": "build/windows-editor",
            "cacheVariables": {
                "BUILD_EDITOR": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-macos-debug",
            "configurePreset": "macos-debug"
        },
        {
            "name": "build-macos",
            "configurePreset": "macos-release"
        },
        {
            "name": "build-windows-debug",
            "configurePreset": "windows-debug"
        },
        {
            "name": "build-windows",
            "configurePreset": "windows-release"
        },
        {
            "name": "build-web-debug",
            "configurePreset": "web-debug"
        },
        {
            "name": "build-web",
            "configurePreset": "web-release"
        },
        {
            "name": "build-macos-editor",
            "configurePreset": "macos-editor"
        },
        {
            "name": "build-windows-editor",
            "configurePreset": "windows-editor"
        }
    ],
    "testPresets": [
        {
            "name": "test-macos-debug",
            "configurePreset": "macos-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "test-macos-release",
            "configurePreset": "macos-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "test-windows-debug",
            "configurePreset": "windows-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "test-windows-release",
            "configurePreset": "windows-release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
