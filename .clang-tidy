Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-throwing-static-initialization,
  -clang-analyzer-cplusplus.NewDeleteLeaks,
  -performance-enum-size
WarningsAsErrors: '*'
HeaderFilterRegex: '^(?!.*/build/).*/(src|tests)/.*'
